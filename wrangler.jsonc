{
  // Cloudflare Workers config for the UNC EVC site (deployed via OpenNext).
  // Docs: https://opennext.js.org/cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uncevc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // D1 database for the Network directory + Ventures repository.
  // The app reads this through the `DB` binding (see src/lib/db.ts).
  // Apply the schema with:
  //   npx wrangler d1 migrations apply uncevc --local   (dev)
  //   npx wrangler d1 migrations apply uncevc --remote  (production)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uncevc",
      "database_id": "9c10a2c3-d0c4-43dc-b8b9-9190ca082bbc",
      "migrations_dir": "migrations"
    }
  ]
}
